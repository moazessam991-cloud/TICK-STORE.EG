# Express preview host
NODE_ENV=production
PORT=38471
TRUST_PROXY=1
TICK_STOREFRONT_ORIGINS=https://preview.example.com

# Must point at a mounted persistent disk in production. SQLite currently
# stores only the local admin drops/audit log, not orders or catalog data.
TICK_DB_PATH=/absolute/persistent/path/tick.sqlite

# Custom admin auth (do not use plaintext TICK_ADMIN_PASSWORD in production).
# Format: scrypt$<base64url salt (>=16 bytes)>$<base64url 64-byte digest>
TICK_ADMIN_PASSWORD_HASH=replace-with-a-generated-scrypt-hash
TICK_JWT_SECRET=replace-with-at-least-32-random-characters

# Supabase project binding. The publishable key is returned to the browser;
# the service role is never exposed to browsers.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public InstaPay instructions. Set enabled=false until all three values are
# deliberately configured on both the Express host and create-order function.
TICK_INSTAPAY_ENABLED=false
TICK_INSTAPAY_RECIPIENT_NAME=replace-with-recipient-name
TICK_INSTAPAY_PAYMENT_URL=https://example.com/replace-with-instapay-link
# TICK_INSTAPAY_QR_URL=https://example.com/optional-instapay-qr.png

# Preview-disabled integration. The admin UI does not advertise push.
TICK_PUSH_ENABLED=false

# create-order Edge Function secrets/config (set in the Supabase function
# environment, not in public frontend code).
TICK_ORDER_ABUSE_SECRET=replace-with-at-least-32-random-characters
TICK_TRUST_EDGE_FORWARDED_IP=true
TICK_ALLOW_LOCALHOST_ORIGINS=false

# Optional manual admin WhatsApp tools. Checkout never sends WhatsApp
# automatically. Leave unset for preview unless separately validated.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=replace-with-auth-token
# TWILIO_WHATSAPP_FROM=whatsapp:+1xxxxxxxxxx
# TWILIO_WEBHOOK_BASE_URL=https://preview.example.com

# Local development only (never use on a preview/production host):
# TICK_ADMIN_PASSWORD=local-development-password
# TICK_ALLOW_LOCALHOST_ORIGINS=true
# TWILIO_SKIP_WEBHOOK_VERIFY=1
